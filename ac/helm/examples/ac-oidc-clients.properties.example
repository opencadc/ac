# Repeat this block for every registered OIDC client. The completed file is
# sensitive because it contains client secrets.

<FILL_CLIENT_ID>.secret = <FILL_CLIENT_SECRET>
<FILL_CLIENT_ID>.description = <FILL_CLIENT_DESCRIPTION>
# Optional. Omit to allow access without a group restriction.
<FILL_CLIENT_ID>.access-group = <FILL_ACCESS_GROUP_URI>
# Supported claims include name, email, and memberOf.
<FILL_CLIENT_ID>.claims = name email memberOf
<FILL_CLIENT_ID>.sign-documents = true
