# LDAP configuration for ac 1.5.0. This completed file is sensitive because
# it contains proxyPassword.

readOnly.servers = <FILL_READ_ONLY_LDAP_HOSTS_SPACE_SEPARATED>
readOnly.poolInitSize = 4
readOnly.poolMaxSize = 100
readOnly.poolPolicy = roundRobin
readOnly.maxWait = 30000
readOnly.createIfNeeded = false

readWrite.servers = <FILL_READ_WRITE_LDAP_HOSTS_SPACE_SEPARATED>
readWrite.poolInitSize = 4
readWrite.poolMaxSize = 10
readWrite.poolPolicy = roundRobin
readWrite.maxWait = 30000
readWrite.createIfNeeded = false

unboundReadOnly.servers = <FILL_UNBOUND_READ_ONLY_LDAP_HOSTS_SPACE_SEPARATED>
unboundReadOnly.poolInitSize = 1
unboundReadOnly.poolMaxSize = 25
unboundReadOnly.poolPolicy = roundRobin
unboundReadOnly.maxWait = 30000
unboundReadOnly.createIfNeeded = false

port = 636

# The ac 1.5.0 ldap service reads both values directly from this file.
proxyUser = <FILL_LDAP_PROXY_USER_DN>
proxyPassword = <FILL_LDAP_PROXY_PASSWORD>

usersDN = <FILL_USERS_DN>
groupsDN = <FILL_GROUPS_DN>
adminGroupsDN = <FILL_ADMIN_GROUPS_DN>
userRequestsDN = <FILL_USER_REQUESTS_DN>
